# Runtime state. Keep this directory private and backed up.
ODR_DATA_DIR=.state
# ODR_DATABASE_URL=sqlite:///C:/absolute/path/open-domain-radar.sqlite3

# The web process binds to loopback by default. Use a TLS reverse proxy and a
# strong public origin before exposing the operator console.
ODR_HOST=127.0.0.1
ODR_PORT=8787
ODR_PUBLIC_ORIGIN=http://127.0.0.1:8787
ODR_EMBED_WORKER=false
ODR_SESSION_HOURS=8

# Generate with: open-domain-radar keygen
# Prefer injecting this from an OS/container secret. If omitted, local init may
# create a private key file below ODR_DATA_DIR.
ODR_MASTER_KEY=

# Passive Certificate Transparency stream. The fixed upstream WSS origin is
# enforced. Collection windows (5-900 seconds) are configured in the console.
ODR_CERTSTREAM_URL=wss://certstream.calidog.io/

# Optional passive enrichers. Missing keys are a normal skipped state and never
# prevent CertStream candidates from being stored.
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
